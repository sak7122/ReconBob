# Secrets / credentials — never commit
secrets/
*.sa.json
*-key.json
.env
.env.*
!.env.example
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / MCP
node_modules/

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
*.swp

# Local data / temp
local_data/
tmp/

# Firebase emulator artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Terraform (keep .terraform.lock.hcl committed for reproducible providers)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tf.plan
crash.log
