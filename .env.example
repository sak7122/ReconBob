# Copy to .env for local dev. Real values live in GCP Secret Manager in prod.
ENV=development                       # development | production

# GCP / Vertex
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GEMINI_OCR_MODEL=gemini-2.0-flash     # Flash by default; Pro on low confidence
GEMINI_PRO_MODEL=gemini-2.0-pro
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa.json

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number for dev

# Bank feed — mock default (Plaid unavailable in India); plaid only with US/EU/CA entity
BANK_FEED=mock

# Guardrails
MAX_RECEIPTS_PER_USER_DAY=100
MAX_GEMINI_CALLS_DAY=5000

# Firestore emulator (local dev only)
FIRESTORE_EMULATOR_HOST=localhost:8080
